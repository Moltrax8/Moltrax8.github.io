{
  "app_title": "Moltrax · Site editor",
  "backend": {
    "name": "github",
    "repo": "Moltrax8/moltrax-site",
    "branch": "main",
    "auth_methods": [
      "token"
    ]
  },
  "site_url": "https://moltrax8.github.io",
  "logo": {
    "src": "/favicon.svg"
  },
  "media_folder": "/public/images",
  "public_folder": "/images",
  "output": {
    "omit_empty_optional_fields": false
  },
  "slug": {
    "encoding": "ascii",
    "clean_accents": true,
    "sanitize_replacement": "-",
    "lowercase": true
  },
