    {
      "name": "projects",
      "label": "Projects (add, edit or remove)",
      "label_singular": "Project",
      "file": "/src/data/projects.json",
      "identifier_field": "title",
      "fields": [
        {
          "name": "slug",
          "label": "URL slug (lowercase, hyphens)",
          "widget": "string",
          "required": true,
          "pattern": [
            "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "Use lowercase letters, numbers and hyphens"
          ]
        },
        {
          "name": "title",
          "label": "Project title",
          "widget": "string"
        },
        {
          "name": "category",
          "label": "Category",
          "widget": "string"
        },
        {
          "name": "summary",
          "label": "Short description",
          "widget": "text"
        },
        {
          "name": "status",
          "label": "Source visibility",
          "widget": "select",
          "options": [
            {
              "label": "Public source",
              "value": "public"
            },
            {
              "label": "Private source",
              "value": "private"
            }
          ]
        },
        {
          "name": "visible",
          "label": "Show project on website",
          "widget": "boolean",
          "default": true
        },
        {
          "name": "homepageFeatured",
          "label": "Show on homepage",
          "widget": "boolean",
          "default": false
        },
        {
          "name": "publicDetail",
          "label": "Create project detail page even if source is private",
          "widget": "boolean",
          "default": false
        },
        {
          "name": "githubUrl",
          "label": "Public GitHub URL (leave empty for private code)",
          "widget": "string",
          "required": false
        },
        {
          "name": "telegramUrl",
          "label": "Telegram bot URL",
          "widget": "string",
          "required": false
        },
        {
          "name": "image",
          "label": "Project cover (optional)",
          "widget": "image",
          "required": false
        },
        {
          "name": "imageAlt",
          "label": "Cover image description",
          "widget": "string",
          "required": false
        },
        {
          "name": "stack",
          "label": "Technologies",
          "widget": "list",
          "required": false,
          "field": {
            "name": "item",
            "widget": "string",
            "label": "Text"
          }
        },
        {
          "name": "overview",
          "label": "Overview paragraphs",
          "widget": "list",
          "required": false,
          "field": {
            "name": "item",
            "widget": "string",
            "label": "Text"
          }
        },
        {
          "name": "highlights",
          "label": "Key features",
          "widget": "list",
          "required": false,
          "field": {
